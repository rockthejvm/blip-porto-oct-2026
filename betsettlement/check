#!/usr/bin/env bash
# Compare your program's output against the expected output for a milestone.
#
#   ./betsettlement/check m1
#
# Prints "m1: OK" if you match, and a diff if you do not.
# The expected files are in betsettlement/expected/ and you are welcome to read them.
#
# By default it runs YOUR program, com.rockthecode.betsettlement.engine.Main. A second
# argument runs a different package instead - which is how the reference
# solutions are checked:
#
#   ./betsettlement/check m3 m3       runs com.rockthecode.betsettlement.m3.Main

set -uo pipefail

MILESTONE="${1:-}"
PACKAGE="${2:-engine}"
if [[ -z "$MILESTONE" ]]; then
  echo "usage: $0 <m1|m2|m3|m4> [package]" >&2
  exit 2
fi

EXPECTED="betsettlement/expected/${MILESTONE}.csv"
if [[ ! -f "$EXPECTED" ]]; then
  echo "no expected output for '${MILESTONE}' (looked for $EXPECTED)" >&2
  exit 2
fi

ACTUAL="$(mktemp)"
trap 'rm -f "$ACTUAL"' EXIT

sbt -batch -error "runMain com.rockthecode.betsettlement.${PACKAGE}.Main betsettlement/data/${MILESTONE}" \
  2>/dev/null | sed '/^[[:space:]]*$/d' > "$ACTUAL"

if diff -u "$EXPECTED" "$ACTUAL" > /dev/null; then
  echo "${MILESTONE}: OK"
else
  echo "${MILESTONE}: does not match"
  echo "  < expected     > yours"
  diff "$EXPECTED" "$ACTUAL"
  exit 1
fi
