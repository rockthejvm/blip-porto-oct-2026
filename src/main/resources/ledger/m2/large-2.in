# purpose: M2 at large size. Six accounts; every account goes through a freeze window and
#          two of them close; malformed lines every few commands so <seq> is tested constantly.
# exercises: all M1/M2 rules and all ERROR variants, interleaved.

OPEN s1 USD
OPEN s2 USD
OPEN s3 EUR
OPEN s4 EUR
OPEN s5 GBP
OPEN s6 GBP

DEPOSIT s1 100
DEPOSIT s2 200
DEPOSIT s3 300
DEPOSIT s4 400
DEPOSIT s5 500
DEPOSIT s6 600

# wave 1
WITHDRAW s1 2.25
FREEZE s2
WITHDRAW s3 9.99
DEPOSIT s3 -1
UNFREEZE s4
WITHDRAW s5 100000
BALANCE s5
DEPOSIT s6 150
WITHDRAW s1

# wave 2
FREEZE s1
WITHDRAW s2 150
DEPOSIT s2 -1
UNFREEZE s3
WITHDRAW s4 100000
BALANCE s4
DEPOSIT s5 1
WITHDRAW s6 33
WITHDRAW S1 1

# wave 3
WITHDRAW s1 0.01
DEPOSIT s1 -1
UNFREEZE s2
WITHDRAW s3 100000
BALANCE s3
DEPOSIT s4 2.25
WITHDRAW s5 33
FREEZE s6
WITHDRAW s1 1.5.5

# wave 4
UNFREEZE s1
WITHDRAW s2 100000
BALANCE s2
DEPOSIT s3 1
WITHDRAW s4 33
FREEZE s5
WITHDRAW s6 150
DEPOSIT s6 -1
OPEN s7 Usd
WITHDRAW s1 100000
BALANCE s1
CLOSE s1

# wave 5
WITHDRAW s1 100000
BALANCE s1
DEPOSIT s2 150
WITHDRAW s3 33
FREEZE s4
WITHDRAW s5 0.01
DEPOSIT s5 -1
UNFREEZE s6
FREEZE

# wave 6
DEPOSIT s1 1
WITHDRAW s2 33
FREEZE s3
WITHDRAW s4 33
DEPOSIT s4 -1
UNFREEZE s5
WITHDRAW s6 100000
BALANCE s6
CLOSE s1 s2
CLOSE s6
BALANCE s6
WITHDRAW s6 600
CLOSE s6
BALANCE s6
OPEN s6 GBP
DEPOSIT s6 1

# wave 7
WITHDRAW s1 33
FREEZE s2
WITHDRAW s3 1
DEPOSIT s3 -1
UNFREEZE s4
WITHDRAW s5 100000
BALANCE s5
DEPOSIT s6 75
DEPOSIT s1 -0.001

# wave 8
FREEZE s1
WITHDRAW s2 2.25
DEPOSIT s2 -1
UNFREEZE s3
WITHDRAW s4 100000
BALANCE s4
DEPOSIT s5 1
WITHDRAW s6 150
withdraw s1 1

# wave 9
WITHDRAW s1 0.10
DEPOSIT s1 -1
UNFREEZE s2
WITHDRAW s3 100000
BALANCE s3
DEPOSIT s4 75
WITHDRAW s5 150
FREEZE s6
WITHDRAW s1

# close what can be closed
UNFREEZE s1
UNFREEZE s2
UNFREEZE s3
UNFREEZE s4
UNFREEZE s5
BALANCE s1
BALANCE s2
BALANCE s3
BALANCE s4
BALANCE s5
CLOSE s1
CLOSE s2
CLOSE s3
CLOSE s4
CLOSE s5
