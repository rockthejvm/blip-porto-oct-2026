# purpose: M1 at large size, eight accounts, deposits in an irregular pattern so that a
#          balance mix-up between accounts shows up as many wrong lines, not one.
# exercises: OPEN/DEPOSIT/BALANCE; unknown-account; account-exists.

OPEN h1 USD
OPEN h2 EUR
DEPOSIT h3 1
OPEN h3 GBP
OPEN h4 USD
OPEN h5 EUR
DEPOSIT h6 1
OPEN h6 GBP
OPEN h7 USD
OPEN h8 EUR

# batch 1
DEPOSIT h1 0.05
DEPOSIT h5 5.55
BALANCE h6
OPEN h7 EUR

# batch 2
DEPOSIT h1 50
DEPOSIT h3 500
DEPOSIT h5 55.5
OPEN h6 EUR
DEPOSIT h7 5

# batch 3
DEPOSIT h1 0.5
DEPOSIT h5 0.01
OPEN h5 EUR
DEPOSIT h11 1
BALANCE h0

# batch 4
DEPOSIT h1 500
DEPOSIT h2 5.55
DEPOSIT h3 55.5
DEPOSIT h4 0.01
OPEN h4 EUR
DEPOSIT h5 5
BALANCE h5
DEPOSIT h6 0.05
DEPOSIT h7 50
DEPOSIT h8 0.5

# batch 5
DEPOSIT h1 5.55
BALANCE h2
OPEN h3 EUR
DEPOSIT h5 0.05

# batch 6
DEPOSIT h1 55.5
OPEN h2 EUR
DEPOSIT h3 5
DEPOSIT h5 50
DEPOSIT h7 500
DEPOSIT h14 1
BALANCE h0

# batch 7
DEPOSIT h1 0.01
OPEN h1 EUR
DEPOSIT h5 0.5
OPEN h8 GBP
BALANCE h8

# batch 8
DEPOSIT h1 5
DEPOSIT h2 0.05
DEPOSIT h3 50
BALANCE h3
DEPOSIT h4 0.5
DEPOSIT h5 500
DEPOSIT h6 5.55
DEPOSIT h7 55.5
OPEN h7 GBP
DEPOSIT h8 0.01

# batch 9
DEPOSIT h1 0.05
BALANCE h4
DEPOSIT h5 5.55
OPEN h6 GBP
DEPOSIT h17 1
BALANCE h0

# batch 10
DEPOSIT h1 50
DEPOSIT h3 500
DEPOSIT h5 55.5
OPEN h5 GBP
DEPOSIT h7 5
BALANCE h7

# final
BALANCE h1
BALANCE h2
BALANCE h3
BALANCE h4
BALANCE h5
BALANCE h6
BALANCE h7
BALANCE h8
